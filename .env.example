# 医疗管家 - 环境变量示例
# 复制为系统环境变量或部署平台配置使用（application.yml 已支持环境变量覆盖）

# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ylgj
DB_USERNAME=root
DB_PASSWORD=123456

# Redis 配置
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT 密钥（生产环境务必替换为强随机密钥，长度不少于 32 字节）
JWT_SECRET=ylgj-health-management-secret-key-2026-change-me

# AI 助手（DeepSeek API Key，不填则走本地兜底回复）
# 申请地址：https://platform.deepseek.com/
DEEPSEEK_API_KEY=
AI_API_URL=https://api.deepseek.com/chat/completions
AI_MODEL=deepseek-chat

# Quartz 定时任务（订单过期扫描，默认每天凌晨 1:00）
QUARTZ_ORDER_EXPIRE_CRON=0 0 1 * * ?
