<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ylgj.mapper.MemberMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.ylgj.pojo.Member">
        <id column="id" property="id" />
        <result column="fileNumber" property="fileNumber" />
        <result column="name" property="name" />
        <result column="sex" property="sex" />
        <result column="idCard" property="idCard" />
        <result column="phoneNumber" property="phoneNumber" />
        <result column="regTime" property="regTime" />
        <result column="password" property="password" />
        <result column="email" property="email" />
        <result column="birthday" property="birthday" />
        <result column="remark" property="remark" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id, fileNumber, name, sex, idCard, phoneNumber, regTime, password, email, birthday, remark
    </sql>

</mapper>
